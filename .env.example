# Zoltraak Environment Variable Overrides
# Copy this file to .env or pass these environment variables in Docker/CI.
# Values set here override config.json.

# Minecraft Server Connection
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Zoltraak
MC_OWNER=YourMinecraftUsername
MC_VERSION=1.21.2

# Autonomous Behaviors
MC_ROAM_RADIUS=16
MC_AUTO_SLEEP=true
MC_AUTO_DEFEND=true
MC_AUTO_FARM=true
